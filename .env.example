# Copia este archivo como .env.local y completa los valores.
# Los encuentras en Supabase: Project Settings > API.

# URL del proyecto (https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon / publishable). Es segura en el navegador porque
# todo el acceso a los datos lo controlan las políticas RLS y las funciones SQL.
# NUNCA pongas aquí la clave service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (service_role). SOLO para el servidor: la usa /api/validar.
# NUNCA la subas a GitHub ni le pongas el prefijo NEXT_PUBLIC_.
# En Vercel agrégala en Settings > Environment Variables como SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
